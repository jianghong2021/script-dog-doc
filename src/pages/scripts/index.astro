---
export const prerender = false;

import AppLayout from '../../layouts/AppLayout.astro';
import Pagination from '../../components/Pagination.astro';
import { getThumbnails, listScripts } from '../../lib/db';
import { getEnv } from '../../lib/utils';

const env = getEnv(Astro.locals);
const url = Astro.url;
const q = url.searchParams.get('q') ?? '';
const type = url.searchParams.get('type') ?? '';
const sort = url.searchParams.get('sort') === 'downloads' ? 'downloads' : 'latest';
const sizeRaw = Number(url.searchParams.get('size'));
const pageSize = [12, 24, 48].includes(sizeRaw) ? sizeRaw : 12;
const page = Math.max(1, Number(url.searchParams.get('page') ?? '1') || 1);

const { items, total, page: currentPage } = await listScripts(env, { q, type, sort, page, pageSize });
const thumbs = await getThumbnails(
	env,
	items.map((item) => item.id)
);
const totalPages = Math.max(1, Math.ceil(total / pageSize));

const query: Record<string, string> = {};
if (q) query.q = q;
if (type) query.type = type;
if (sort !== 'latest') query.sort = sort;
if (pageSize !== 12) query.size = String(pageSize);

const typeLabels: Record<string, string> = {
	content: '内容脚本',
	window: '独立窗口',
	sidePanel: '侧边栏',
	editorPlugin: '编辑器扩展',
};

const parseTags = (value: string | null): string[] => {
	if (!value) return [];
	try {
		const parsed = JSON.parse(value);
		return Array.isArray(parsed) ? parsed.slice(0, 4) : [];
	} catch {
		return [];
	}
};
---

<AppLayout title="脚本市场">
	<section class="hero">
		<div>
			<h1>脚本市场</h1>
			<p class="sd-muted">发现、安装、分享脚本盒子脚本。安装前请先安装「脚本盒子」浏览器扩展。</p>
		</div>
		<a class="sd-btn" href="/upload">上传脚本</a>
	</section>

	<form class="filters" method="get" action="/scripts">
		<input class="sd-input" type="search" name="q" placeholder="搜索脚本名称、作者、描述…" value={q} />
		<select class="sd-select" name="type">
			<option value="">全部类型</option>
			{Object.entries(typeLabels).map(([value, label]) => (
				<option value={value} selected={type === value}>{label}</option>
			))}
		</select>
		<select class="sd-select" name="sort">
			<option value="latest" selected={sort === 'latest'}>最新发布</option>
			<option value="downloads" selected={sort === 'downloads'}>下载最多</option>
		</select>
		<select class="sd-select" name="size">
			<option value="12" selected={pageSize === 12}>12 / 页</option>
			<option value="24" selected={pageSize === 24}>24 / 页</option>
			<option value="48" selected={pageSize === 48}>48 / 页</option>
		</select>
		<button class="sd-btn" type="submit">搜索</button>
	</form>

	{
		items.length === 0 ? (
			<div class="sd-empty">暂无脚本，快来发布第一个吧～</div>
		) : (
			<div class="grid">
				{items.map((item) => {
					const thumb = thumbs.get(item.id);
					const tags = parseTags(item.tags);
					return (
						<a class="card sd-card" href={`/scripts/${item.id}`}>
							<div class="thumb">
								{thumb ? (
									<img src={`/api/images/${thumb.id}`} alt={item.name} loading="lazy" />
								) : (
									<div class="thumb-placeholder">脚本</div>
								)}
							</div>
							<div class="body">
								<h2>{item.name}</h2>
								<p class="desc sd-muted">{item.description || '暂无简介'}</p>
								<div class="meta">
									<span class="sd-tag">{typeLabels[item.script_type ?? ''] ?? '脚本'}</span>
									{tags.map((tag) => (
										<span class="sd-tag">{tag}</span>
									))}
								</div>
								<div class="foot sd-muted">
									<span>{item.author || '未知作者'} · v{item.version || '1.0.0'}</span>
									<span>{item.downloads} 次安装</span>
								</div>
							</div>
						</a>
					);
				})}
			</div>
		)
	}

	<Pagination
		basePath="/scripts"
		page={currentPage}
		totalPages={totalPages}
		total={total}
		pageSize={pageSize}
		query={query}
	/>
</AppLayout>

<style>
	.hero {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 20px;
	}
	.hero h1 {
		margin: 0 0 4px;
		font-size: 26px;
	}
	.hero p {
		margin: 0;
		font-size: 14px;
	}
	.filters {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
		margin-bottom: 16px;
	}
	.filters .sd-input {
		flex: 1 1 240px;
	}
	.filters .sd-select {
		width: auto;
		min-width: 120px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 16px;
	}
	.card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transition: border-color 0.15s, transform 0.15s;
	}
	.card:hover {
		border-color: var(--sd-primary);
		transform: translateY(-2px);
	}
	.thumb {
		aspect-ratio: 16 / 10;
		background: var(--sd-soft);
		overflow: hidden;
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.thumb-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--sd-muted);
		font-size: 14px;
		letter-spacing: 4px;
	}
	.body {
		padding: 14px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		flex: 1;
	}
	.body h2 {
		margin: 0;
		font-size: 16px;
	}
	.desc {
		margin: 0;
		font-size: 13px;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		min-height: 36px;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.foot {
		margin-top: auto;
		display: flex;
		justify-content: space-between;
		font-size: 12px;
	}
</style>
